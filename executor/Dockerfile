# Official Apache Spark image: Java 11, Spark 3.5.0 under /opt/spark and python3
# are already installed, so neither the JDK nor the Spark tarball has to be
# fetched during the build. The version matches the one the jobs ask for in
# spark.kubernetes.container.image, so submitter and cluster stay in step.
FROM apache/spark:3.5.0
LABEL authors="panagiotis_tsolkas"

# The base image runs as the unprivileged 'spark' user; installing packages
# and writing to /usr/local/bin needs root.
USER root

# Environment Variables
ENV PYTHONHASHSEED=1
# Keep apt from asking questions during the build (nobody is there to answer)
ENV DEBIAN_FRONTEND=noninteractive
ENV CERTIFICATE_AUTHORITY_
ENV CLIENT_CERTIFICATE_
ENV CLIENT_KEY_DATA=''
ENV SERVER=https://192.168.0.201:16443

# Set working directory
WORKDIR /KubernetesAPI/executor

# python3 ships with the base image; pip and curl do not.
# Everything in one layer, with the apt cache removed afterwards.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Download and install kubectl, verifying the published checksum
RUN KUBECTL_VERSION="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" && \
    curl -fsSLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && \
    curl -fsSLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl.sha256" && \
    echo "$(cat kubectl.sha256)  kubectl" | sha256sum --check && \
    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
    rm -f kubectl kubectl.sha256 && \
    kubectl version --client

# Copy all files from directory and install python's requirements
COPY ./* .
RUN python3 -m pip install --no-cache-dir -r requirements2.txt

# Write the cluster configuration where kubectl actually looks for it (~/.kube/config)
RUN mkdir -p /root/.kube && bash ./kubectl_config.sh && kubectl config get-contexts

CMD ["python3", "JobExecutor.py"]
